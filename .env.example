# Copy to .env and set real values. .env is not committed to git.

POSTGRES_USER=health
POSTGRES_PASSWORD=change_me_in_env
POSTGRES_DB=health_os
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection string for the app/Alembic (host port above)
DATABASE_URL=postgresql+psycopg://health:change_me_in_env@localhost:5432/health_os

# Read-only role for MCP reads (SELECT on approved views only). Password lives only here, outside git.
# After filling in: alembic upgrade head && python -m scripts.setup_readonly
READONLY_DB_PASSWORD=change_me_readonly
READONLY_DATABASE_URL=postgresql+psycopg://health_readonly:change_me_readonly@localhost:5432/health_os

# Optional cloud LLM API (only with commercial/zero-data-retention terms for real medical data).
# Not needed for interactive use through an MCP client or with local models.
ANTHROPIC_API_KEY=

# Critical-alert channel (Phase 1). Empty = fallback to log / macOS notification.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Crisis hotline country code (safety/crisis.py): UA, ES, US, GB/UK, DE, PL. Default UA.
CRISIS_COUNTRY=UA
